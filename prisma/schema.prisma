generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GymPlan {
  BASIC
  PRO
  ENTERPRISE
}

model Gym {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  address   String?
  logoUrl   String?
  plan      GymPlan  @default(BASIC)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  professionals  Professional[]
  equipment      Equipment[]
  operatingHours OperatingHours[]
}

model User {
  id            String    @id @default(uuid())
  gymId         String
  name          String
  email         String    @unique
  phone         String?
  avatarUrl     String?
  bio           String?
  birthDate     DateTime?
  passwordHash  String
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  showInRanking Boolean   @default(true)

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, email])
  @@index([gymId])
}

model Professional {
  id           String   @id @default(uuid())
  gymId        String
  name         String
  email        String   @unique
  phone        String?
  avatarUrl    String?
  specialty    String?
  cref         String?
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, email])
  @@index([gymId])
}

model Equipment {
  id          String          @id @default(uuid())
  gymId       String
  name        String
  photoUrl    String?
  description String?
  usageTips   String?
  muscleGroup String?
  status      EquipmentStatus @default(AVAILABLE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
}

enum EquipmentStatus {
  AVAILABLE
  MAINTENANCE
  INACTIVE
}

model OperatingHours {
  id        String  @id @default(uuid())
  gymId     String
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean @default(false)

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, dayOfWeek])
}
